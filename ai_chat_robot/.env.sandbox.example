# Sandbox 相关配置（复制为 .env 或合并到项目根 .env）

# Docker 镜像（需本机已安装 Docker Desktop）
SANDBOX_DOCKER_IMAGE=python:3.11-slim

# 本机调试脚本时的 workspace 路径（一般不用改）
# SANDBOX_WORKSPACE=./sandbox/workspace

# 策略（已在 sandbox/config.py 代码中固化，此处仅作文档）
# - Shell 白名单：仅 python/python3 + scripts/ 下脚本
# - Docker 网络：network_mode=none（无外网）
# - 工作区保留：不跨天（每次 run 新建沙箱）
