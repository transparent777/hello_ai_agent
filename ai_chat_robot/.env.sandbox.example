# Sandbox 相关配置（复制为 .env 或合并到项目根 .env）

# --- Docker 镜像 ---
SANDBOX_DOCKER_IMAGE=python:3.11-slim
# 启动时将 tag 解析为 digest，避免镜像漂移（P0）
SANDBOX_PIN_IMAGE_DIGEST=true

# --- P0: 安全策略 ---
# 默认禁止本机 subprocess 回退；仅本地开发可设为 true
SANDBOX_ALLOW_LOCAL_FALLBACK=false
SANDBOX_REQUIRE_DOCKER=true
# 并发沙箱会话上限（P0）
SANDBOX_MAX_CONCURRENT_SESSIONS=2
# Shell 命令超时（秒）
SANDBOX_EXEC_TIMEOUT_SECONDS=120
# 启动时清理僵尸/超时容器
SANDBOX_CLEANUP_ON_STARTUP=true
SANDBOX_STALE_CONTAINER_MAX_AGE_HOURS=24

# --- P0: Web 访问认证（留空则本地免登录）---
WEB_APP_API_KEY=

# --- P1: 可靠性 ---
SANDBOX_RUN_TIMEOUT_SECONDS=300
SANDBOX_RUN_MAX_RETRIES=2
SANDBOX_HEALTH_CHECK_ON_STARTUP=true

# --- E: 沙箱持久化与记忆 ---
# 同一会话内 resume 沙箱工作区（session_state）
SANDBOX_PERSIST_SESSION=true
# 将 output 摘要写入 memories/memory_summary.md 供下次分析参考
SANDBOX_MEMORY_ENABLED=true
# SANDBOX_PERSIST_ROOT=./sandbox/persist

# 产物出沙箱前最大体积（字节），默认 10MB
SANDBOX_ARTIFACT_MAX_BYTES=10485760

# Manifest.environment 可放非密钥变量（已在 config.py 配置 PYTHONUNBUFFERED 等）
# 切勿把 DEEPSEEK_API_KEY 等写入 manifest 或此处

# --- 审计与指标日志 ---
# SANDBOX_AUDIT_LOG=./logs/sandbox_audit.jsonl
# SANDBOX_METRICS_LOG=./logs/sandbox_metrics.jsonl

# 策略（已在代码中固化，此处仅作文档）
# - Shell 白名单：仅 python/python3 + scripts/ 下脚本
# - Docker 网络：network_mode=none（无外网）
# - repo/、data/、scripts/：Manifest 只读 + path grant
# - Skills：sandbox/skills/ 懒加载到 .agents/skills/
# - 产物审查：publish 到 reports/ 前检查密钥与大小
# - 工作区保留：不跨天（每次 run 新建沙箱）
